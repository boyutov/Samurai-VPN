#!/bin/bash
# macOS package: refuse early when the WireGuard tools are missing (see docs/MACOS.md).
for prefix in /opt/homebrew/bin /usr/local/bin; do
    [[ -x "$prefix/wireguard-go" && -x "$prefix/wg" ]] && exit 0
done
echo 'Samurai VPN needs wireguard-go and wg: brew install wireguard-go wireguard-tools' >&2
exit 1
