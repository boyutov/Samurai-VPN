<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>dev.samurai.vpn</groupId><artifactId>samurai-vpn</artifactId><version>0.3.0-SNAPSHOT</version></parent>
  <artifactId>vpn-desktop</artifactId>
  <dependencies>
    <dependency><groupId>dev.samurai.vpn</groupId><artifactId>vpn-linux</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>dev.samurai.vpn</groupId><artifactId>vpn-windows</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>dev.samurai.vpn</groupId><artifactId>vpn-macos</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>dev.samurai.vpn</groupId><artifactId>vpn-client</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>dev.samurai.vpn</groupId><artifactId>vpn-server</artifactId><version>${project.version}</version></dependency>
  </dependencies>
  <build><finalName>samurai-desktop</finalName><plugins><plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId>
    <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
      <createDependencyReducedPom>false</createDependencyReducedPom>
      <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>dev.samurai.vpn.desktop.DesktopMain</mainClass><manifestEntries><Multi-Release>true</Multi-Release></manifestEntries></transformer></transformers>
      <filters><filter><artifact>*:*</artifact><excludes><exclude>module-info.class</exclude><exclude>META-INF/versions/*/module-info.class</exclude></excludes></filter></filters>
    </configuration></execution></executions>
  </plugin></plugins></build>
</project>
